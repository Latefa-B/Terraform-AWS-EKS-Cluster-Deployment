# Explanation: IAM Role for the EKS Cluster itself.
# This role grants permissions for the EKS control plane to manage AWS resources (e.g., EC2 instances, ENIs).
resource "aws_iam_role" "eks_cluster_role" {
  name = "${var.cluster_name}-cluster-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "eks.amazonaws.com"
        }
      },
    ]
  })
}

# Explanation: Attaches the AmazonEKSClusterPolicy to the cluster role.
resource "aws_iam_role_policy_attachment" "eks_cluster_policy_attachment" {
  policy_arn = "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
  role       = aws_iam_role.eks_cluster_role.name
}

# Explanation: Attaches the AmazonEKSVPCResourceController policy (required for EKS to manage ENIs).
resource "aws_iam_role_policy_attachment" "eks_cluster_vpc_resource_controller_attachment" {
  policy_arn = "arn:aws:iam::aws:policy/AmazonEKSVPCResourceController"
  role       = aws_iam_role.eks_cluster_role.name
}

# Explanation: IAM Role for the EKS Worker Nodes.
# This role grants permissions for worker nodes to join the EKS cluster and interact with AWS services.
resource "aws_iam_role" "eks_node_role" {
  name = "${var.cluster_name}-node-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Action = "sts:AssumeRole"
        Effect = "Allow"
        Principal = {
          Service = "ec2.amazonaws.com"
        }
      },
    ]
  })
}

# Explanation: Attaches the AmazonEKSWorkerNodePolicy to the worker node role.
resource "aws_iam_role_policy_attachment" "eks_worker_node_policy_attachment" {
  policy_arn = "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy"
  role       = aws_iam_role.eks_node_role.name
}

# Explanation: Attaches the AmazonEC2ContainerRegistryReadOnly policy (allows nodes to pull Docker images from ECR).
resource "aws_iam_role_policy_attachment" "eks_cni_policy_attachment" {
  policy_arn = "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy"
  role       = aws_iam_role.eks_node_role.name
}

# Explanation: Attaches the AmazonEC2ContainerRegistryReadOnly policy (allows nodes to pull Docker images from ECR).
resource "aws_iam_role_policy_attachment" "eks_ecr_read_only_policy_attachment" {
  policy_arn = "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly"
  role       = aws_iam_role.eks_node_role.name
}

